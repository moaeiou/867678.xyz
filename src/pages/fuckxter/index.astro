---
//css
import "../../styles/fuckxter/style.css";
//layouts
import FuckxterLayout from "../../layouts/FuckxterLayout.astro";
---

<FuckxterLayout title="FuckXter">
  <div class="fk-app" data-fuckxter>
    <header class="fk-topbar">
      <a class="fk-brand" href="/fuckxter" aria-label="FuckXter 首页">
        <img
          class="fk-logo-img fk-logo-light"
          src="/FuckXter_simple.avif"
          alt="FuckXter"
          width="499"
          height="128"
          decoding="async"
        />
        <img
          class="fk-logo-img fk-logo-dark"
          src="/FuckXter_simple_BK.avif"
          alt="FuckXter"
          width="515"
          height="128"
          decoding="async"
        />
      </a>

      <div class="fk-search">
        <svg
          class="fk-search-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          class="fk-search-input"
          type="search"
          placeholder="搜索 FuckXter"
          aria-label="搜索 FuckXter"
          autocomplete="off"
        />
      </div>

      <nav class="fk-tabs" aria-label="时间线">
        <button type="button" class="fk-tab is-active" data-tab="foryou">
          推荐
        </button>
        <button type="button" class="fk-tab" data-tab="following">
          关注
        </button>
      </nav>

      <div class="fk-account">
        <button
          type="button"
          class="fk-account-btn"
          data-role="account-btn"
          aria-label="账号"
          aria-expanded="false"
          aria-haspopup="menu"
        >
          <span class="fk-account-avatar" data-role="account-avatar" hidden
          ></span>
          <svg
            class="fk-account-icon"
            data-role="account-icon"
            viewBox="0 0 24 24"
            width="21"
            height="21"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"></path>
          </svg>
        </button>

        <div
          class="fk-menu fk-account-menu"
          data-role="account-menu"
          role="menu"
          hidden
        >
          <!-- 未登录：登录 / 注册入口 -->
          <div data-role="auth-items">
            <p class="fk-menu-title">登录 FuckXter</p>
            <button
              type="button"
              class="fk-menu-item"
              role="menuitem"
              data-auth-open="signin"
            >
              登录
            </button>
            <button
              type="button"
              class="fk-menu-item"
              role="menuitem"
              data-auth-open="signup"
            >
              注册账号
            </button>
          </div>

          <!-- 已登录：账号操作 -->
          <div data-role="user-items" hidden>
            <div class="fk-menu-user">
              <span class="fk-menu-user-avatar" data-role="menu-avatar"></span>
              <span class="fk-menu-user-meta">
                <strong data-role="menu-name"></strong>
                <small data-role="menu-handle"></small>
              </span>
            </div>
            <button
              type="button"
              class="fk-menu-item"
              role="menuitem"
              data-account-open="settings"
            >
              账号设置
            </button>
          </div>

          <!-- 主题外观：登录与否都可用 -->
          <div class="fk-menu-row">
            <button
              type="button"
              class="fk-menu-item fk-menu-expandable"
              role="menuitem"
              aria-expanded="false"
              aria-haspopup="menu"
              data-account-open="theme"
            >
              主题外观
              <span class="fk-menu-arrow" aria-hidden="true">▸</span>
            </button>
            <!-- 三级菜单：账号按钮 → 账号菜单 → 主题外观 -->
            <div
              class="fk-submenu"
              data-role="theme-submenu"
              role="menu"
              hidden
            >
              <button
                type="button"
                class="fk-menu-item"
                role="menuitemradio"
                data-theme-choice="auto"
              >
                <span class="fk-menu-check">✓</span>跟随系统
              </button>
              <button
                type="button"
                class="fk-menu-item"
                role="menuitemradio"
                data-theme-choice="light"
              >
                <span class="fk-menu-check">✓</span>浅色
              </button>
              <button
                type="button"
                class="fk-menu-item"
                role="menuitemradio"
                data-theme-choice="dark"
              >
                <span class="fk-menu-check">✓</span>深色
              </button>
            </div>
          </div>

          <!-- 已登录：退出登录 -->
          <div data-role="signout-items" hidden>
            <hr class="fk-menu-sep" />
            <button
              type="button"
              class="fk-menu-item"
              role="menuitem"
              data-account-action="signout"
            >
              退出登录
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="fk-main">
      <section class="fk-composer" aria-label="发帖">
        <div class="fk-avatar"></div>
        <div class="fk-composer-body">
          <textarea
            class="fk-composer-input"
            rows="2"
            placeholder="有什么新鲜事？"
            aria-label="发帖内容"></textarea>
          <div class="fk-composer-foot">
            <span class="fk-char-count">0 / 500</span>
            <button type="button" class="fk-post-btn" disabled>发帖</button>
          </div>
        </div>
      </section>

      <section class="fk-feed" aria-label="信息流"></section>

      <div class="fk-sentinel">
        <span class="fk-spinner" aria-hidden="true"></span>
      </div>
    </div>
  </div>

  <!-- 登录 / 注册弹窗（占位：后端就绪前仅存于本机） -->
  <div class="fk-modal" data-role="auth-modal" hidden>
    <div class="fk-modal-backdrop" data-role="auth-backdrop"></div>
    <div
      class="fk-dialog"
      role="dialog"
      aria-modal="true"
      aria-label="登录或注册"
    >
      <div class="fk-dialog-brand">
        <img
          class="fk-dialog-logo fk-logo-light"
          src="/FuckXter_simple.avif"
          alt=""
          width="499"
          height="128"
        />
        <img
          class="fk-dialog-logo fk-logo-dark"
          src="/FuckXter_simple_BK.avif"
          alt=""
          width="515"
          height="128"
        />
      </div>

      <div class="fk-dialog-tabs" role="tablist" aria-label="登录或注册">
        <button
          type="button"
          class="fk-dialog-tab is-active"
          role="tab"
          aria-selected="true"
          data-auth-tab="signin"
        >
          登录
        </button>
        <button
          type="button"
          class="fk-dialog-tab"
          role="tab"
          aria-selected="false"
          data-auth-tab="signup"
        >
          注册
        </button>
      </div>

      <form data-role="signin-form" novalidate>
        <label class="fk-field">
          <span class="fk-field-label">邮箱</span>
          <input
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
        </label>
        <label class="fk-field">
          <span class="fk-field-label">密码</span>
          <input
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="至少 8 位"
            required
            minlength="8"
          />
        </label>
        <p class="fk-form-status" data-role="signin-status" aria-live="polite">
        </p>
        <button class="fk-primary-btn" type="submit">登录</button>
        <p class="fk-form-hint">忘记密码？后端就绪后将支持恢复密钥找回。</p>
      </form>

      <form data-role="signup-form" hidden novalidate>
        <label class="fk-field">
          <span class="fk-field-label">昵称</span>
          <input
            name="name"
            type="text"
            maxlength="20"
            placeholder="给自己起个名字"
            required
          />
        </label>
        <label class="fk-field">
          <span class="fk-field-label">邮箱</span>
          <input
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
        </label>
        <label class="fk-field">
          <span class="fk-field-label">密码</span>
          <input
            name="password"
            type="password"
            autocomplete="new-password"
            placeholder="至少 8 位"
            required
            minlength="8"
          />
        </label>
        <p class="fk-form-status" data-role="signup-status" aria-live="polite">
        </p>
        <button class="fk-primary-btn" type="submit">创建账号</button>
        <p class="fk-form-hint">演示环境：账号仅保存在本机浏览器，不会上传。</p>
      </form>

      <button
        type="button"
        class="fk-dialog-close"
        data-role="auth-close"
        aria-label="关闭"
      >
        ×
      </button>
    </div>
  </div>

  <!-- 账号设置弹窗：个人资料 / 安全 / S3 存储（均为占位 UI） -->
  <div class="fk-modal" data-role="settings-modal" hidden>
    <div class="fk-modal-backdrop" data-role="settings-backdrop"></div>
    <div
      class="fk-dialog fk-dialog-wide"
      role="dialog"
      aria-modal="true"
      aria-label="账号设置"
    >
      <nav class="fk-settings-nav" aria-label="设置分类">
        <button
          type="button"
          class="fk-settings-nav-btn is-active"
          data-settings-tab="profile"
        >
          个人资料
        </button>
        <button
          type="button"
          class="fk-settings-nav-btn"
          data-settings-tab="security"
        >
          安全
        </button>
        <button
          type="button"
          class="fk-settings-nav-btn"
          data-settings-tab="storage"
        >
          S3 存储
        </button>
      </nav>

      <div class="fk-settings-body">
        <!-- 个人资料 -->
        <section data-settings-pane="profile">
          <h3 class="fk-settings-title">个人资料</h3>
          <div class="fk-profile-head">
            <span class="fk-profile-avatar" data-role="profile-avatar"></span>
            <button
              type="button"
              class="fk-ghost-btn"
              disabled
              title="图片上传接入后开放"
            >
              更换头像
            </button>
          </div>
          <form data-role="profile-form" novalidate>
            <label class="fk-field">
              <span class="fk-field-label">昵称</span>
              <input name="name" type="text" maxlength="20" required />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">用户名</span>
              <input
                name="handle"
                type="text"
                disabled
                title="用户名暂不支持修改"
              />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">个人简介</span>
              <textarea
                name="bio"
                rows="4"
                maxlength="200"
                placeholder="介绍一下自己（200 字以内）"></textarea>
              <span class="fk-char-count" data-role="bio-count">0 / 200</span>
            </label>
            <p class="fk-form-status" aria-live="polite"></p>
            <button class="fk-primary-btn" type="submit">保存更改</button>
          </form>
        </section>

        <!-- 安全：邮箱 / 密码 / 2FA / 恢复密钥 -->
        <section data-settings-pane="security" hidden>
          <h3 class="fk-settings-title">安全</h3>

          <form class="fk-fieldset" data-role="email-form" novalidate>
            <p class="fk-fieldset-title">更改邮箱</p>
            <p class="fk-form-hint">
              当前邮箱：<span data-role="current-email"></span>
            </p>
            <label class="fk-field">
              <span class="fk-field-label">新邮箱</span>
              <input
                name="email"
                type="email"
                placeholder="new@example.com"
                required
              />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">当前密码</span>
              <input
                name="password"
                type="password"
                autocomplete="current-password"
                required
              />
            </label>
            <p class="fk-form-status" aria-live="polite"></p>
            <button class="fk-primary-btn" type="submit">更新邮箱</button>
          </form>

          <form class="fk-fieldset" data-role="password-form" novalidate>
            <p class="fk-fieldset-title">更改密码</p>
            <label class="fk-field">
              <span class="fk-field-label">当前密码</span>
              <input
                name="current"
                type="password"
                autocomplete="current-password"
                required
              />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">新密码</span>
              <input
                name="next"
                type="password"
                autocomplete="new-password"
                minlength="8"
                placeholder="至少 8 位"
                required
              />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">确认新密码</span>
              <input
                name="confirm"
                type="password"
                autocomplete="new-password"
                required
              />
            </label>
            <p class="fk-form-status" aria-live="polite"></p>
            <button class="fk-primary-btn" type="submit">更新密码</button>
          </form>

          <div class="fk-fieldset">
            <p class="fk-fieldset-title">两步验证（2FA）</p>
            <p class="fk-form-hint" data-role="tfa-status"></p>

            <div data-role="tfa-off">
              <button type="button" class="fk-ghost-btn" data-role="tfa-start"
                >添加 2FA</button
              >
            </div>

            <div data-role="tfa-setup" hidden>
              <p class="fk-form-hint">1. 在验证器 App 中手动添加以下密钥：</p>
              <code class="fk-tfa-secret" data-role="tfa-secret"></code>
              <p class="fk-form-hint">
                2. 输入 App 显示的 6 位验证码完成绑定：
              </p>
              <div class="fk-inline-row">
                <input
                  class="fk-tfa-code"
                  data-role="tfa-code"
                  inputmode="numeric"
                  maxlength="6"
                  placeholder="123456"
                  autocomplete="one-time-code"
                />
                <button
                  type="button"
                  class="fk-primary-btn"
                  data-role="tfa-confirm">确认开启</button
                >
                <button
                  type="button"
                  class="fk-ghost-btn"
                  data-role="tfa-cancel">取消</button
                >
              </div>
              <p
                class="fk-form-status"
                data-role="tfa-setup-status"
                aria-live="polite"
              >
              </p>
            </div>

            <div data-role="tfa-on" hidden>
              <button
                type="button"
                class="fk-ghost-btn"
                data-role="recovery-generate"
              >
                生成恢复密钥
              </button>
              <div data-role="recovery-box" hidden>
                <ol class="fk-recovery-list" data-role="recovery-list"></ol>
                <button
                  type="button"
                  class="fk-ghost-btn"
                  data-role="recovery-copy">复制全部</button
                >
                <p class="fk-form-hint">
                  恢复密钥只显示一次，请立即保存到安全的地方。
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- S3 兼容存储 -->
        <section data-settings-pane="storage" hidden>
          <h3 class="fk-settings-title">S3 兼容存储</h3>
          <p class="fk-form-hint">
            连接你自己的对象存储（S3 API
            兼容），媒体文件将直接上传到你的桶中，存储成本完全由你掌控。
          </p>
          <form data-role="s3-form" novalidate>
            <label class="fk-field">
              <span class="fk-field-label">Endpoint</span>
              <input
                name="endpoint"
                type="url"
                placeholder="https://s3.example.com"
                required
              />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">Region</span>
              <input name="region" type="text" placeholder="us-east-1" />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">Bucket</span>
              <input
                name="bucket"
                type="text"
                placeholder="my-fuckxter-media"
                required
              />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">Access Key ID</span>
              <input
                name="accessKeyId"
                type="text"
                autocomplete="off"
                placeholder="AKIA…"
                required
              />
            </label>
            <label class="fk-field">
              <span class="fk-field-label">Secret Access Key</span>
              <input
                name="secretAccessKey"
                type="password"
                autocomplete="off"
                placeholder="••••••••"
                required
              />
            </label>
            <label class="fk-check-row">
              <input name="pathStyle" type="checkbox" />
              <span>使用路径风格寻址（path-style，MinIO 等自建存储常用）</span>
            </label>
            <p class="fk-form-status" aria-live="polite"></p>
            <div class="fk-inline-row">
              <button class="fk-ghost-btn" type="button" data-role="s3-test"
                >测试连接</button
              >
              <button class="fk-primary-btn" type="submit">保存</button>
            </div>
          </form>
        </section>
      </div>

      <button
        type="button"
        class="fk-dialog-close"
        data-role="settings-close"
        aria-label="关闭"
      >
        ×
      </button>
    </div>
  </div>
</FuckxterLayout>

<script>
  import { mountFuckxterBySelector } from "../../lib/fuckxter/client";

  document.addEventListener("astro:page-load", () => {
    mountFuckxterBySelector("[data-fuckxter]");
  });
</script>
